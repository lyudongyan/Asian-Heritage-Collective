---
import '../styles/global.css';
import Nav from '../components/Nav';
import logo from '../assets/images/logo.webp';

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
}

const {
  title = "Asian Heritage Collective",
  description = "Asian Heritage Collective makes language and cultural learning something young people choose to be part of.",
  ogImage = logo.src,
  ogType = "website",
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, "https://asianheritagecollective.org").href;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Social media previews -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.url).href} />
    <meta property="og:site_name" content="Asian Heritage Collective" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.url).href} />

    <!-- Favicon -->
    <link rel="icon" href={logo.src} type="image/webp" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

  </head>
  <body>
    <div class="site-loader" aria-hidden="true">
      <div class="loader-brand">
        <img src={logo.src} alt="" />
        <div>
          <strong>AHC</strong>
          <span>Asian Heritage Collective</span>
        </div>
      </div>
      <div class="loader-track"><span></span></div>
    </div>
    <Nav currentPath={Astro.url.pathname} client:load />
    <slot />
    <aside class="cookie-notice" role="dialog" aria-labelledby="cookie-title" aria-describedby="cookie-description">
      <div class="cookie-copy">
        <strong id="cookie-title">Your privacy choices</strong>
        <p id="cookie-description">We use necessary cookies and browser storage to keep this site working. With your permission, optional cookies may help us understand site use and improve the experience. Your choice is saved on this device.</p>
      </div>
      <div class="cookie-actions">
        <button type="button" data-cookie-choice="denied">Deny optional</button>
        <button type="button" class="cookie-accept" data-cookie-choice="accepted">Accept all</button>
      </div>
    </aside>
    <script is:inline>
      (() => {
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const coarse = window.matchMedia('(hover: none), (pointer: coarse)').matches;

        const reveals = document.querySelectorAll('.reveal');
        if (reduced || !('IntersectionObserver' in window)) {
          reveals.forEach((element) => element.classList.add('in-view'));
        } else {
          const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('in-view');
                observer.unobserve(entry.target);
              }
            });
          }, { threshold: 0.16, rootMargin: '0px 0px -86px' });
          reveals.forEach((element) => observer.observe(element));
        }

        let scrollFrame = 0;
        const updateProgress = () => {
          scrollFrame = 0;
          const max = Math.max(1, document.documentElement.scrollHeight - innerHeight);
          document.body.style.setProperty('--page-progress', String(Math.min(1, scrollY / max)));
          document.querySelectorAll('[data-viewport-card]').forEach((card) => {
            const rect = card.getBoundingClientRect();
            const center = rect.top + rect.height / 2;
            const distance = Math.min(1, Math.abs(center - innerHeight / 2) / (innerHeight * .72));
            card.style.setProperty('--edge-dim', String(.08 + distance * .34));
          });
        };
        addEventListener('scroll', () => {
          if (!scrollFrame) scrollFrame = requestAnimationFrame(updateProgress);
        }, { passive: true });
        updateProgress();

        const finishLoading = () => {
          setTimeout(() => document.documentElement.classList.add('site-ready'), reduced ? 0 : 520);
          const cookieNotice = document.querySelector('.cookie-notice');
          let cookieChoice = null;
          try { cookieChoice = localStorage.getItem('ahc-cookie-choice'); } catch (_) {}
          if (!cookieChoice) setTimeout(() => cookieNotice?.classList.add('is-visible'), reduced ? 0 : 1250);
        };
        if (document.readyState === 'complete') finishLoading();
        else addEventListener('load', finishLoading, { once: true });
        setTimeout(() => document.documentElement.classList.add('site-ready'), 2600);

        document.querySelectorAll('[data-cookie-choice]').forEach((button) => {
          button.addEventListener('click', () => {
            const choice = button.getAttribute('data-cookie-choice');
            try { localStorage.setItem('ahc-cookie-choice', choice || 'denied'); } catch (_) {}
            const notice = button.closest('.cookie-notice');
            notice?.setAttribute('data-choice', choice || 'denied');
            notice?.classList.remove('is-visible');
            notice?.classList.add('is-dismissed');
          });
        });

        if (!reduced && !coarse) {
          let pointerFrame = 0;
          let latest;
          document.addEventListener('pointermove', (event) => {
            latest = event;
            if (pointerFrame) return;
            pointerFrame = requestAnimationFrame(() => {
              pointerFrame = 0;
              const surface = latest.target instanceof Element ? latest.target.closest('[data-glass]') : null;
              if (!surface) return;
              const rect = surface.getBoundingClientRect();
              surface.style.setProperty('--glass-x', `${((latest.clientX - rect.left) / rect.width * 100).toFixed(1)}%`);
              surface.style.setProperty('--glass-y', `${((latest.clientY - rect.top) / rect.height * 100).toFixed(1)}%`);
            });
          }, { passive: true });
        }
      })();
    </script>
  </body>
</html>
