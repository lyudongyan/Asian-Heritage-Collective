---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { BLOG_POSTS } from '../../data/blogPosts';

export function getStaticPaths() {
  return BLOG_POSTS.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;

// Dynamically resolve the image from the assets folder at build time
const allImages = import.meta.glob<{ default: ImageMetadata }>('../../assets/images/*', { eager: true });
const imgMeta: ImageMetadata | undefined = allImages[`../../assets/images/${post.imageFile}`]?.default;
const imgSrc: string = (imgMeta as any)?.src ?? '';

// Find adjacent posts for prev/next navigation
const postIndex = BLOG_POSTS.findIndex(p => p.slug === post.slug);
const prevPost = postIndex > 0 ? BLOG_POSTS[postIndex - 1] : null;
const nextPost = postIndex < BLOG_POSTS.length - 1 ? BLOG_POSTS[postIndex + 1] : null;
---

<Layout
  title={`${post.title} | AHC Blog`}
  description={post.excerpt}
  ogImage={imgSrc}
  ogType="article"
>
  <div class="pt-32 pb-24 min-h-screen bg-[#faf8f6] select-text relative text-left">
    <div class="container mx-auto px-6 md:px-12 max-w-3xl animate-fade-in">

      {/* Back to Blog */}
      <a
        href="/blog"
        class="mb-8 font-body text-xs font-bold uppercase tracking-widest text-primary hover:text-primary-container inline-flex items-center gap-2 bg-white px-5 py-2.5 rounded-full border border-primary/10 transition-all hover:scale-[1.02] active:scale-95 shadow-sm no-underline"
      >
        <span class="material-symbols-outlined text-[16px]">arrow_back</span>
        Back to Blog
      </a>

      {/* Article */}
      <article class="bg-white border border-neutral-100 rounded-3xl p-6 md:p-10 shadow-sm space-y-8">

        {/* Meta */}
        <div class="space-y-4 animate-slide-up-fade">
          <div class="flex flex-wrap gap-2 items-center text-xs text-on-surface-variant/70 font-semibold font-mono">
            <span>{post.date}</span>
            <span class="w-1.5 h-1.5 rounded-full bg-neutral-300"></span>
            <span>By {post.author}</span>
            <span class="w-1.5 h-1.5 rounded-full bg-neutral-300"></span>
            <span class="bg-primary/10 text-primary px-3 py-1 rounded-full text-[9px] font-bold uppercase tracking-widest font-mono">
              {post.tag}
            </span>
          </div>
          <h1 class="font-headline text-3xl md:text-5xl text-primary font-bold leading-tight">
            {post.title}
          </h1>
        </div>

        {/* Cover Image */}
        {imgMeta && (
          <div class="w-full h-64 md:h-[450px] overflow-hidden rounded-2xl border border-neutral-100 shadow-inner animate-slide-up-fade delay-100">
            <Image
              src={imgMeta}
              alt={post.title}
              class="w-full h-full object-cover"
              loading="eager"
              fetchpriority="high"
              widths={[400, 800, 1200]}
              sizes="(max-width: 768px) 100vw, 768px"
            />
          </div>
        )}

        {/* Excerpt pull-quote */}
        <div class="p-5 border-l-4 border-primary/20 bg-primary/5 rounded-r-2xl italic font-body text-base text-on-surface-variant/90 leading-relaxed animate-slide-up-fade delay-200">
          "{post.excerpt}"
        </div>

        {/* Content — each paragraph rendered as its own <p> tag */}
        <div class="font-body text-base md:text-lg text-on-surface-variant/95 leading-relaxed space-y-6 animate-slide-up-fade delay-300">
          {post.content.split('\n\n').map(para => (
            <p>{para.trim()}</p>
          ))}
        </div>

        {/* Prev / Next navigation */}
        <div class="border-t border-neutral-100 pt-8 mt-12 flex items-center justify-between gap-4 animate-slide-up-fade delay-400">
          {prevPost ? (
            <a
              href={`/blog/${prevPost.slug}`}
              class="font-body text-xs font-bold uppercase tracking-widest text-primary hover:text-primary-container inline-flex items-center gap-2 bg-white px-5 py-2.5 rounded-full border border-primary/10 transition-all hover:scale-[1.02] active:scale-95 shadow-sm no-underline"
            >
              <span class="material-symbols-outlined text-[16px]">arrow_back</span>
              Previous Post
            </a>
          ) : <div />}

          {nextPost ? (
            <a
              href={`/blog/${nextPost.slug}`}
              class="font-body text-xs font-bold uppercase tracking-widest text-primary hover:text-primary-container inline-flex items-center gap-2 bg-white px-5 py-2.5 rounded-full border border-primary/10 transition-all hover:scale-[1.02] active:scale-95 shadow-sm no-underline"
            >
              Next Post
              <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
            </a>
          ) : <div />}
        </div>
      </article>
    </div>
  </div>
</Layout>

<script>
  // Scroll-reveal IntersectionObserver for this static page
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) entry.target.classList.add('in-view');
      });
    },
    { threshold: 0.1, rootMargin: '0px 0px -60px 0px' }
  );
  document.querySelectorAll('.scroll-reveal, .scroll-reveal-left, .scroll-reveal-right, .scroll-reveal-scale')
    .forEach(el => observer.observe(el));
</script>
