---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { PAST_EVENTS } from '../../data/pastEvents';
import Footer from '../../components/Footer';

export function getStaticPaths() {
  return PAST_EVENTS.map(evt => ({ params: { id: evt.id }, props: { evt } }));
}

const { evt } = Astro.props;
const allImages = import.meta.glob<{ default: ImageMetadata }>('../../assets/images/*', { eager: true });
const resolveImage = (filename: string): ImageMetadata | undefined => allImages[`../../assets/images/${filename}`]?.default;
const cover = resolveImage(evt.imageFile);
const gallery = evt.imageFiles.map(resolveImage).filter(Boolean) as ImageMetadata[];
const index = PAST_EVENTS.findIndex(item => item.id === evt.id);
const previous = index > 0 ? PAST_EVENTS[index - 1] : null;
const next = index < PAST_EVENTS.length - 1 ? PAST_EVENTS[index + 1] : null;
---

<Layout title={`${evt.title} | AHC Events`} description={evt.desc} ogImage={cover?.src ?? ''}>
  <main class="page-shell detail-page">
    <div class="detail-wrap detail-wrap-wide">
      <a class="back-link" href="/events">Back to Events</a>
      <article class="detail-card liquid-surface liquid-light" data-glass>
        <header class="detail-header">
          <div class="detail-meta">
            <span>{evt.date}</span>
            <span>{evt.location}</span>
          </div>
          <h1>{evt.title}</h1>
          <p>{evt.desc}</p>
        </header>

        {cover && (
          <Image
            src={cover}
            alt={evt.title}
            class="detail-cover"
            loading="eager"
            fetchpriority="high"
            widths={[480, 900, 1280]}
            sizes="(max-width: 960px) 100vw, 900px"
          />
        )}

        {gallery.length > 1 && (
          <section class="event-gallery" aria-labelledby="gallery-title">
            <h2 id="gallery-title">Photos</h2>
            <div>
              {gallery.map((image, imageIndex) => (
                <Image
                  src={image}
                  alt={`${evt.title}, photo ${imageIndex + 1}`}
                  loading="lazy"
                  widths={[360, 640, 900]}
                  sizes="(max-width: 700px) 100vw, 33vw"
                />
              ))}
            </div>
          </section>
        )}

        <nav class="detail-pagination" aria-label="More events">
          {previous ? <a href={`/events/${previous.id}`}>Previous</a> : <span></span>}
          {next ? <a href={`/events/${next.id}`}>Next</a> : <span></span>}
        </nav>
      </article>
    </div>
  </main>
  <Footer />
</Layout>
